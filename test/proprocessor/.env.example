# .env.example
# Copy to .env and fill in your values.

# ---- LLM ----
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- Concurrency / retry ----
LLM_MAX_CONCURRENCY=50
LLM_MAX_RETRIES=3
LLM_BASE_BACKOFF=1.0
LLM_TIMEOUT=60.0

CALL_CONCURRENCY=20
PAIR_CONCURRENCY=200

# ---- Paths ----
PROMPTS_PATH=./prompts/prompts.yaml
OUTPUT_DIR=./offline_output
INPUT_PATH=./samples.json